# Copy to .env and adjust for your deployment. Development needs none of these.

# Required when DJANGO_DEBUG=0. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 0 for production, 1 (default) for development.
DJANGO_DEBUG=1

# Comma-separated hostnames allowed to serve the app (production).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated https origins for CSRF (e.g. https://rampviz.example.gov).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional: load corridor JSON files from a directory outside the repo,
# so your network definitions live with your data, not the code.
# RMV_CORRIDOR_DIR=/etc/rampviz/corridors
